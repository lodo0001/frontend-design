---
import PlusIcon from "../icons/plus.svg";
const { exclusive, ...props } = Astro.props;
const { id, question, answer, linkBlock } = props;
---

<details {id} {...exclusive ? { name: "faq" } : {}}>
  <summary>
    <span>
      {question}
      <PlusIcon />
    </span>
  </summary>
  <div class="content">
    <div class="answer">
      {answer.map((a) => <p set:html={a} />)}
      {
        linkBlock && (
          <a class="link-block" href={linkBlock.url} target="_blank">
            {linkBlock.label}
          </a>
        )
      }
    </div>
  </div>
</details>

<style>
  details {
    color: hsl(190 30% 12%);
    border-bottom: 1px solid #dadada;

    --r: rotate(0deg);

    ::details-content {
      height: 0;
      overflow: clip;
      transition: 0.3s allow-discrete;
    }

    &[open] {
      --r: rotate(180deg);
    }

    &[open] svg path.vertical {
      transform: scaleY(0);
    }

    &[open]::details-content {
      height: auto;
    }

    summary {
      font-weight: 700;
      color: #181818;
      text-wrap: revert;
      user-select: none;

      &::marker,
      &::-webkit-details-marker {
        content: "";
        display: none;
      }

      span {
        border: none;
        text-align: start;
        padding: 0;
        inline-size: 100%;
        padding-block: 1rlh;
        display: flex;
        gap: 1rem;
        justify-content: space-between;
        align-items: center;

        svg {
          inline-size: auto;
          height: 1lh;
          flex-shrink: 0;

          transform: var(--r);
          transition: transform 0.3s ease;

          path.vertical {
            transform-origin: center;
            transform: scaleY(1);
            transition: transform 0.3s ease;
          }
        }
      }
    }

    .answer {
      color: #595566;

      > * + * {
        margin-top: 1em;
      }

      :last-child {
        padding-block-end: 1rlh;
      }

      .link-block {
        display: block;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    details ::details-content {
      transition: none;
    }

    details summary span svg {
      transition: none;
    }
  }
</style>
